<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa">
  <h:head>
    <h:title>Geo Variants</h:title>
    <model>
      <instance>
        <data id="geo-variants">
          <point_default/>
          <point_placement_map/>
          <shape_default/>
          <trace_default/>
        </data>
      </instance>
      <bind nodeset="/data/point_default" type="geopoint"/>
      <bind nodeset="/data/point_placement_map" type="geopoint"/>
      <bind nodeset="/data/shape_default" type="geoshape"/>
      <bind nodeset="/data/trace_default" type="geotrace"/>
    </model>
  </h:head>
  <h:body>
    <input ref="/data/point_default"><label>Geopoint default</label></input>
    <input ref="/data/point_placement_map" appearance="placement-map"><label>Geopoint placement-map</label></input>
    <input ref="/data/shape_default"><label>Geoshape default</label></input>
    <input ref="/data/trace_default"><label>Geotrace default</label></input>
  </h:body>
</h:html>
